# ============================================================
# SAM — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file.
# ============================================================

# --- Ollama ---
# URL for local Ollama server (default: http://localhost:11434)
SAM_OLLAMA_URL=http://localhost:11434

# Cloud model to use (requires ollama signin)
SAM_CLOUD_MODEL=gemma4:cloud

# Local fallback model (must be pulled: ollama pull qwen2.5:7b)
SAM_LOCAL_MODEL=qwen2.5:7b

# Vision model (must be pulled: ollama pull llama3.2-vision)
SAM_VISION_MODEL=llama3.2-vision

# --- Paths ---
# Override the default memory database location
SAM_MEMORY_DB=data/sam_memory.db

# Override the downloads directory for file operations
SAM_DOWNLOADS_DIR=C:/Users/your_username/Downloads

# --- Safety ---
# Set to "true" to enforce strict high-risk confirmation guards
SAM_STRICT_SAFETY=true

# --- Personality & Voice ---
# TTS voice for online mode (edge-tts voice name)
SAM_TTS_VOICE=en-GB-RyanNeural

# Default personality mode: "casual" or "task"
SAM_DEFAULT_MODE=casual

# --- Optional External Multimodal / LLM Services ---
# FREELLMAPI_URL=http://127.0.0.1:31415
# FREELLMAPI_KEY=your_optional_api_key_here

